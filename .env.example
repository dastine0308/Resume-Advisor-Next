# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integration / E2E tests (optional — defaults to http://localhost:3000)
TEST_BASE_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq — used by AI routes (analyze job, enrich description, cover letter)
GROQ_API_KEY=your-groq-api-key

# LaTeX PDF service (Next.js gateway → latex-service container)
LATEX_SERVICE_URL=http://localhost:5400
# Optional Next.js gateway timeouts (defaults: queue wait 120s + pdflatex 60s + 10s buffer = 190s)
# LATEX_COMPILE_QUEUE_WAIT_MS=120000
# LATEX_COMPILE_TIMEOUT_MS=190000
# LaTeX container only (docker-compose / Azure Container App):
# MAX_CONCURRENT_COMPILES=2
# MAX_COMPILE_QUEUE=5
# COMPILE_QUEUE_WAIT_MS=120000
# Limits are per replica — with MAX_REPLICAS=2, total capacity ≈ replicas × (MAX_CONCURRENT + MAX_QUEUE).
# The Next.js gateway probes /health/ready before each compile; when the queue is full it returns
# HTTP 503 immediately (clients retry via debounce) rather than waiting in the service queue.

# Stripe (Pro subscription)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
